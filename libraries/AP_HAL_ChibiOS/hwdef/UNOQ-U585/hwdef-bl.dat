# hw definition file for processing by chibios_hwdef.py
# Arduino UNO Q (ABX00162): bootloader for its STM32U585

include hwdef.inc

# bootloader at the start of flash, app after 4 x 8k pages
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 32

define BOOTLOADER_BAUDRATE 115200

# LED3 (RGB, active low): green = bootloader, blue = activity
PH11 LED_BOOTLOADER OUTPUT HIGH
PH12 LED_ACTIVITY OUTPUT HIGH
define HAL_LED_ON 0
