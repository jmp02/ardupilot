# hw definition file for processing by chibios_hwdef.py
# Arduino UNO Q (ABX00162): bootloader for its STM32U585. The board's QRB2210 (Linux) is the
# companion computer; besides SWD, its only link to the STM32 is LPUART1 (/dev/ttyHS1 on Linux).

# MCU class and specific type
MCU STM32U5xx STM32U585xx

# 16 MHz crystal
OSCILLATOR_HZ 16000000

# board ID: development value, not yet allocated in Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID 5999

FLASH_SIZE_KB 2048

# bootloader at the start of flash, app after 4 x 8k pages
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 32

# the bootloader protocol runs on LPUART1 to the QRB2210; the STM32 has no USB connection
SERIAL_ORDER LPUART1
PG7 LPUART1_TX LPUART1
PG8 LPUART1_RX LPUART1

# RTS to the QRB2210, held asserted so the Linux side can always send
PG6 QRB_RTS OUTPUT LOW

define BOOTLOADER_BAUDRATE 115200

# LED3 (RGB, active low): green = bootloader, blue = activity
PH11 LED_BOOTLOADER OUTPUT HIGH
PH12 LED_ACTIVITY OUTPUT HIGH
define HAL_LED_ON 0

# SWD
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# no DMA until ArduPilot has a GPDMA backend (M6)
define DMA_RESERVE_SIZE 0
define HAL_UART_NODMA
